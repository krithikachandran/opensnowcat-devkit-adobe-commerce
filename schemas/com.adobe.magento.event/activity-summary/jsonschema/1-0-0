{
  "description": "Schema for aggregated activity tracking on page unload or visibility event",
  "properties": {
    "minXOffset": {
      "type": "integer",
      "minimum": 0
    },
    "maxXOffset": {
      "type": "integer",
      "minimum": 0
    },
    "minYOffset": {
      "type": "integer",
      "minimum": 0
    },
    "maxYOffset": {
      "type": "integer",
      "minimum": 0
    },
    "pings": {
      "type": "integer"
    },
    "ping_interval": {
      "type": "integer"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "pageUnload",
        "visibilityHidden"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "minXOffset",
    "maxXOffset",
    "minYOffset",
    "maxYOffset",
    "eventType",
    "pings",
    "ping_interval"
  ],
  "self": {
    "vendor": "com.adobe.magento.event",
    "name": "activity-summary",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "$schema": "http://iglucentral.com/schemas/com.snowplowanalytics.self-desc/schema/jsonschema/1-0-0#"
}
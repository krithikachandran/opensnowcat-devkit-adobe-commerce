# OpenSnowcat Devkit - Environment Variables
#
# To create a working .env, run:
#   make init-env
#
# This copies this file to .env and generates random values for the
# local-only secrets (IGLU_SUPER_API_KEY, IGLU_DB_PASSWORD). You then
# fill in the cloud credentials by hand.
#
# Or, manually:
#   cp .env.example .env
#   # then edit .env to fill in every blank below

# ─── Snowplow BDP (for pulling schemas via Data Structures API) ───
SNOWPLOW_CONSOLE_ORG_ID=your-org-id
SNOWPLOW_CONSOLE_API_KEY_ID=your-api-key-id
SNOWPLOW_CONSOLE_API_KEY=your-api-key

# ─── Snowflake (for streaming loader) ───
# Snowpipe Streaming uses key-pair auth. Generate a key with:
#   make snowflake-keypair
# Then register the public key on the Snowflake user (see snowflake/README.md).
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=web
SNOWFLAKE_ROLE=your-role
SNOWFLAKE_PRIVATE_KEY_PATH=./snowflake/snowflake-key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ─── Iglu Server (local only, generated by `make init-env`) ───
# IGLU_SUPER_API_KEY: any UUID — used to authenticate API calls to the local Iglu Server
# IGLU_DB_PASSWORD: any string — password for the local Postgres backing Iglu Server
IGLU_SUPER_API_KEY=
IGLU_DB_PASSWORD=

# ─── MaxMind (for IP lookup enrichment) ───
# Sign up free at https://www.maxmind.com/en/geolite2/signup, generate a license key,
# then run: make fetch-enrichment-data
MAXMIND_LICENSE_KEY=

# ─── AWS (for IAB enrichment — pulls list files from Snowplow's hosted S3 bucket) ───
# These must be credentials with read access to:
#   s3://snowplow-hosted-assets-proprietary-us-east-1/third-party/com.iab
# BDP customers can request these from their Snowplow account team.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
